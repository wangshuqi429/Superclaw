SUPERCLAW_HOST=127.0.0.1
SUPERCLAW_PORT=8080
SUPERCLAW_DB_PATH=superclaw.db
SUPERCLAW_MAX_DIFF_BYTES=1048576
SUPERCLAW_MAX_STEPS=8
SUPERCLAW_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
SUPERCLAW_AUTH_REQUIRED=false
SUPERCLAW_AUTH_SECRET=
SUPERCLAW_BOOTSTRAP_ADMIN_USERNAME=
SUPERCLAW_BOOTSTRAP_ADMIN_PASSWORD=
SUPERCLAW_DEFAULT_TENANT_ID=default
SUPERCLAW_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
SUPERCLAW_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
SUPERCLAW_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
SUPERCLAW_OPENROUTER_API_KEY=
SUPERCLAW_OPENROUTER_SITE_URL=
SUPERCLAW_OPENROUTER_APP_NAME=Superclaw

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
SUPERCLAW_LLM_BASE_URL=
SUPERCLAW_LLM_API_KEY=
SUPERCLAW_LLM_MODEL=

# Replay evaluation and evolution activation gate
SUPERCLAW_EVAL_MAX_CASES=5
SUPERCLAW_EVAL_MIN_CASES=3
SUPERCLAW_EVAL_MIN_HOLDOUT_CASES=2
SUPERCLAW_EVAL_MIN_IMPROVEMENT=0.01
SUPERCLAW_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
SUPERCLAW_GITHUB_WEBHOOK_SECRET=
SUPERCLAW_GITHUB_TOKEN=
SUPERCLAW_AUTO_POST_REVIEW=false
SUPERCLAW_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
SUPERCLAW_DATABASE_URL=
SUPERCLAW_REDIS_URL=
SUPERCLAW_ASYNC_WORKERS=2
SUPERCLAW_QUEUE_MAX_ATTEMPTS=3
SUPERCLAW_QUEUE_LEASE_SECONDS=60
SUPERCLAW_SKILLS_DIR=skills
SUPERCLAW_SKILL_SANDBOX=true
SUPERCLAW_SKILL_TIMEOUT_SECONDS=30
SUPERCLAW_SKILL_MEMORY_MB=256
SUPERCLAW_SKILL_SIGNING_KEY=

# Repair verification and observability
SUPERCLAW_REPAIR_TEST_COMMAND=
SUPERCLAW_REPAIR_VERIFY_TIMEOUT_SECONDS=120
SUPERCLAW_AGENT_MAX_WORKERS=4
SUPERCLAW_AGENT_RETRIES=1
SUPERCLAW_COLLABORATION_ROUNDS=2
SUPERCLAW_AGENT_LOOP_MAX_STEPS=4
SUPERCLAW_AGENT_LOOP_TIMEOUT_SECONDS=45
SUPERCLAW_CONTEXT_MAX_TOKENS=12000
SUPERCLAW_CONTEXT_RESERVED_TOKENS=2500
SUPERCLAW_MEMORY_ENABLED=true
SUPERCLAW_MEMORY_RECALL_LIMIT=6
SUPERCLAW_MEMORY_WORKING_TTL_SECONDS=86400
SUPERCLAW_OTEL_ENDPOINT=
SUPERCLAW_OTEL_SERVICE_NAME=superclaw
SUPERCLAW_ALERT_FAILURE_RATE=0.20
SUPERCLAW_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
SUPERCLAW_GITHUB_APP_ID=
SUPERCLAW_GITHUB_APP_SLUG=
SUPERCLAW_GITHUB_PRIVATE_KEY_PATH=
SUPERCLAW_PUBLIC_BASE_URL=http://127.0.0.1:8080
